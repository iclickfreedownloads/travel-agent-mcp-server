# Travel Agent MCP Server - Environment Configuration
# Copy this file to .env and add your API keys

# ===================================================================
# LOCATION & MAPPING SERVICES
# ===================================================================

# Google Maps Platform API (Recommended)
# Free tier: $200 credit/month (~40,000 requests)
# Get it: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Alternative: Mapbox API
# Free tier: 50,000 requests/month
# Get it: https://www.mapbox.com/
MAPBOX_API_KEY=

# ===================================================================
# FLIGHT SEARCH SERVICES
# ===================================================================

# Amadeus Travel API (Recommended for flights)
# Free tier: 2,000 calls/month
# Get it: https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Alternative: AviationStack API
# Free tier: 100 requests/month
# Get it: https://aviationstack.com/
AVIATIONSTACK_API_KEY=

# ===================================================================
# HOTEL & ACCOMMODATION SERVICES
# ===================================================================

# RapidAPI Key (For multiple hotel APIs)
# Free tier: Varies by API (typically 100-500 requests/month)
# Get it: https://rapidapi.com/
# Subscribe to: Booking.com, Hotels.com, Priceline APIs
RAPIDAPI_KEY=

# ===================================================================
# ACTIVITIES & TOURS
# ===================================================================

# Note: RapidAPI key above also works for TripAdvisor API
# Alternative: Direct TripAdvisor API
# Contact: https://www.tripadvisor.com/developers

# ===================================================================
# WEATHER SERVICES
# ===================================================================

# OpenWeatherMap API (Recommended)
# Free tier: 1,000 calls/day
# Get it: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Alternative: WeatherAPI.com
# Free tier: 1M calls/month
# Get it: https://www.weatherapi.com/
WEATHERAPI_KEY=

# ===================================================================
# CURRENCY & EXCHANGE RATES
# ===================================================================

# ExchangeRate-API (Recommended)
# Free tier: 1,500 requests/month
# Get it: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# Alternative: Fixer.io
# Free tier: 100 requests/month
# Get it: https://fixer.io/
FIXER_API_KEY=

# ===================================================================
# FEATURE FLAGS
# ===================================================================

# Use mock data instead of real APIs (true/false)
# Set to true for testing without API keys
USE_MOCK_DATA=false

# Enable web scraping as fallback when APIs are unavailable (true/false)
# Recommended: true (provides graceful fallback)
ENABLE_WEB_SCRAPING=true

# Enable detailed logging (true/false)
DEBUG_MODE=false

# ===================================================================
# OPTIONAL ADVANCED SETTINGS
# ===================================================================

# API request timeout in milliseconds
API_TIMEOUT=10000

# Maximum number of results to return per search
MAX_RESULTS=10

# Cache duration for API responses (in seconds)
CACHE_DURATION=3600

# Default currency for pricing
DEFAULT_CURRENCY=USD

# Default language for content
DEFAULT_LANGUAGE=en
